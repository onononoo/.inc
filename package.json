{
  "name": "inc-editor",
  "productName": ".inc",
  "version": "0.1.0",
  "description": "An open-source code editor built for large engineering organizations.",
  "license": "MIT",
  "private": true,
  "author": ".inc contributors",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "package": "node scripts/package.mjs",
    "licenses": "node scripts/licenses.mjs",
    "docs": "node scripts/gen-docs.mjs",
    "docs:check": "node scripts/gen-docs.mjs --check",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run docs:check && npm run check:hygiene"
  },
  "dependencies": {
    "@parcel/watcher": "^2.6.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "editorconfig": "^3.0.2",
    "electron": "^44.4.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "iconv-lite": "^0.7.3",
    "ignore": "^7.0.10",
    "jschardet": "^4.0.0",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.48.0",
    "monaco-editor": "^0.57.0",
    "picomatch": "^4.0.7",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  }
}
